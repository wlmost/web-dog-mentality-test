# Debug- und Test-Endpoints sperren
# Diese Dateien dürfen in keiner Umgebung öffentlich erreichbar sein.
<FilesMatch "^(debug|debug-.+|test-.+|generate-password)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
